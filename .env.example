# ============================================
# AI Arbitrage System - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values

# === Application Settings ===
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
API_KEY=your-api-key-for-client-access

# === AI Provider Configuration ===
# Recommended: Google Gemini (FREE tier available)
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your-google-api-key

# Alternative: OpenAI (Paid)
# AI_PROVIDER=openai
# AI_MODEL=gpt-4
# OPENAI_API_KEY=your-openai-api-key

# Alternative: Anthropic (Paid)
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-sonnet-20240229
# ANTHROPIC_API_KEY=your-anthropic-api-key

# === Database Configuration ===
# PostgreSQL (ACID compliance for transactions)
DATABASE_URL=postgresql://user:password@localhost:5432/arbitrage_db
DB_PASSWORD=changeme_in_production

# MongoDB (High-volume price scrapes)
MONGO_URL=mongodb://localhost:27017/arbitrage_db

# Redis (Caching and job queue)
REDIS_URL=redis://localhost:6379/0

# === Marketplace APIs ===
# Amazon Price History (HIGHLY RECOMMENDED)
KEEPA_API_KEY=your-keepa-api-key

# Book Pricing
BOOKSCOUTER_API_KEY=your-bookscouter-api-key

# Trading Cards
TCGPLAYER_API_KEY=your-tcgplayer-api-key
TCGPLAYER_PUBLIC_KEY=your-tcgplayer-public-key
TCGPLAYER_PRIVATE_KEY=your-tcgplayer-private-key

# Amazon Restrictions Checker
BUYBOTPRO_API_KEY=your-buybotpro-api-key

# Price Comparison
PRICECHARTING_API_KEY=your-pricecharting-api-key

# LEGO Pricing
BRICKLINK_CONSUMER_KEY=your-bricklink-consumer-key
BRICKLINK_CONSUMER_SECRET=your-bricklink-consumer-secret
BRICKLINK_TOKEN_VALUE=your-bricklink-token
BRICKLINK_TOKEN_SECRET=your-bricklink-token-secret

# === Amazon SP-API (Selling Platform) ===
AMAZON_SP_CLIENT_ID=your-sp-client-id
AMAZON_SP_CLIENT_SECRET=your-sp-client-secret
AMAZON_SP_REFRESH_TOKEN=your-refresh-token
AMAZON_REGION=us-east-1
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# === eBay API ===
EBAY_APP_ID=your-ebay-app-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_CERT_ID=your-ebay-cert-id
EBAY_TOKEN=your-ebay-token
EBAY_SANDBOX=false

# === Payment Processing ===
STRIPE_API_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# === Communication Services ===
# SMS Notifications
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email Notifications
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=AI Arbitrage System

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# === Monitoring & Error Tracking ===
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Prometheus Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# === Frontend Configuration ===
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# For Vercel deployment
VERCEL_URL=your-vercel-deployment-url.vercel.app

# === Cloud Storage (Optional) ===
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=arbitrage-images

# === Security ===
# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Session Configuration
SESSION_SECRET=your-session-secret-min-32-chars
SESSION_MAX_AGE=86400

# === Logging ===
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# === Automation Settings ===
AUTO_PURCHASE=false
AUTO_LIST=true
AUTO_RESPOND_SUPPORT=true
AUTO_NEGOTIATE=true

# === Risk Management ===
MAX_PURCHASE_PER_ITEM=500
MAX_DAILY_SPEND=2000
MAX_WEEKLY_SPEND=10000
MIN_PROFIT_MARGIN=0.20

# === Railway Deployment (Automatically provided) ===
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=auto-provided
# RAILWAY_SERVICE_ID=auto-provided
# DATABASE_URL=auto-provided (PostgreSQL)
# REDIS_URL=auto-provided
# MONGO_URL=auto-provided

# === Feature Flags ===
ENABLE_WEB_SCRAPING=true
ENABLE_ML_PREDICTIONS=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_ADVANCED_ANALYTICS=true
